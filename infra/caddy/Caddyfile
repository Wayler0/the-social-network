# infra/caddy/Caddyfile — development only (plain HTTP on localhost:8080).
# The production Caddyfile (real domain, automatic HTTPS, TLS 1.3 only, HSTS)
# is a separate task; see infra/README.md.
{
	auto_https off
}

:80 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Uncomment when the API service exists in docker-compose.yml:
	# handle /api/* {
	# 	reverse_proxy api:3000
	# }

	handle {
		respond "Hatua dev stack is up. The API and web app are not wired in yet." 200
	}
}
