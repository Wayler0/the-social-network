# infra/.env.example — copy to infra/.env and change every password.
# infra/.env is ignored by git. Never commit real secrets.

APP_ENV=development

# PostgreSQL + PostGIS
POSTGRES_DB=hatua
POSTGRES_USER=hatua
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# S3-compatible object storage (images)
S3_ACCESS_KEY=hatua-dev
S3_SECRET_KEY=change-me-storage-min-8-chars
S3_BUCKET=hatua-media
S3_REGION=us-east-1
S3_PORT=9000
S3_CONSOLE_PORT=9001
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# Caddy (http://localhost:8080 in development)
HTTP_PORT=8080

# What the API will use (for Kim) — same values as above:
# DATABASE_URL=postgresql://hatua:change-me-postgres@localhost:5432/hatua
# REDIS_URL=redis://:change-me-redis@localhost:6379
# S3_ENDPOINT=http://localhost:9000
