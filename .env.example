# Copy to .env (never commit .env).
POSTGRES_PASSWORD=change-me
DB_PORT=5434
DATABASE_URL=postgres://hatua:change-me@127.0.0.1:5434/hatua
APP_NAME=Hatua
APP_URL=http://localhost:5180
# Uploaded images (local dev: apps/api/media, ignored by git). On the server the API container uses /data/media.
# MEDIA_DIR=media
# IMAGE_MAX_BYTES=8388608
# IMAGE_UPLOADS_PER_HOUR=30

# Email (sign-in codes) — docs/email.md.
# Development: leave EMAIL_MODE unset; codes are printed to the API console.
# Server: EMAIL_MODE=smtp plus the settings below. Test with: npm run email:test -w apps/api -- you@example.org
# EMAIL_MODE=smtp
# EMAIL_FROM=Hatua <no-reply@your-domain.example>
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false          # true only for port 465
# SMTP_REQUIRE_TLS=true      # false only for a relay on the same private network
# SMTP_USER=
# SMTP_PASS=
