# Copy to .env (never commit .env).
POSTGRES_PASSWORD=change-me
DB_PORT=5434
DATABASE_URL=postgres://hatua:change-me@127.0.0.1:5434/hatua
APP_NAME=Hatua
APP_URL=http://localhost:5180
# Sign-in. CODE_PEPPER is required on the server: openssl rand -base64 48 (keep it out of Git).
# Development and tests use a built-in value when it is empty.
CODE_PEPPER=
# SESSION_COOKIE=hatua_session

# Database tests (npm run test:db -w apps/api). Each test rolls back, so the dev database is safe to use.
TEST_DATABASE_URL=postgres://hatua:change-me@127.0.0.1:5434/hatua
# Uploaded images (local dev: apps/api/media, ignored by git). On the server the API container uses /data/media.
# MEDIA_DIR=media
# IMAGE_MAX_BYTES=8388608
# IMAGE_UPLOADS_PER_HOUR=30

# Email (sign-in codes) — docs/email.md.
# Development: leave EMAIL_MODE unset; codes are printed to the API console.
# Server: EMAIL_MODE=smtp plus the settings below. Test with: npm run email:test -w apps/api -- you@example.org
# EMAIL_MODE=smtp
# EMAIL_FROM=Hatua <no-reply@your-domain.example>
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false          # true only for port 465
# SMTP_REQUIRE_TLS=true      # false only for a relay on the same private network
# SMTP_USER=
# SMTP_PASS=

# Backups (database + uploaded images, encrypted, off the server) — deploy/backup/README.md.
# RESTIC_REPOSITORY=s3:https://<storage-endpoint>/<bucket>/hatua
# RESTIC_PASSWORD=<long random passphrase — ALSO keep a copy off this server, or the backups are unreadable>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BACKUP_PING_URL=            # optional: a monitor URL to call after each successful backup
# BACKUP_FAIL_URL=            # optional: a monitor URL to call when a backup or restore test fails
# BACKUP_RESTORE_PING_URL=    # optional: a monitor URL to call after each successful restore test
