{
  "name": "@hatua/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "email:test": "tsx --env-file-if-exists=../../.env src/email/send-test.ts",
    "admin:grant": "tsx --env-file-if-exists=../../.env src/admin/grant-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "fastify": "^5.1.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
