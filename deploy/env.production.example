# Server settings. On the server: cp deploy/env.production.example .env, fill every <...>, chmod 600 .env.
# Never commit .env. Keep a copy of it in the team's password manager (backups don't include it).

# ---- Domain and HTTPS
# The public address, without https://. Its DNS A record must point at this server before the first start.
# Not a tharaka.ac.ke subdomain (CLAUDE.md, Positioning).
SITE_ADDRESS=<pilot.your-domain.example>
APP_URL=https://<pilot.your-domain.example>
APP_NAME=Hatua

# ---- Database: openssl rand -hex 24
POSTGRES_PASSWORD=<random>

# ---- Sign-in: openssl rand -base64 48 (the API refuses to start without it)
CODE_PEPPER=<random>

# ---- Email for sign-in codes (docs/email.md). Until this works nobody can sign in.
EMAIL_MODE=smtp
EMAIL_FROM=Hatua <no-reply@your-domain.example>
SMTP_HOST=<smtp.your-provider.example>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=<user>
SMTP_PASS=<password>

# ---- Web Push (push notifications). Make once per server, inside the running API:
#   docker compose exec api node dist/notifications/push-keys.js
# New keys later unsubscribe every browser. All three or none (none = push off, inbox still works).
# VAPID_SUBJECT: mailto:<team address> or an https:// page, never a personal address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Backups (deploy/backup/README.md). Fill in before real members join.
# RESTIC_REPOSITORY=s3:https://<storage-endpoint>/<bucket>/hatua
# RESTIC_PASSWORD=<long random passphrase, also in the password manager>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Only when another web server sits in front (deploy/behind-proxy.yml)
# WEB_PORT=8080
